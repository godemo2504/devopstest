---
- name: Configuration post-install Proxmox + Cluster
  hosts: proxmox
  gather_facts: yes
  become: yes

  vars:
    cluster_name: "mon-cluster"
    first_node: "pve1"
    first_node_ip: "192.168.122.129"
    domain: "lab.local"

  tasks:
    # ---------- Dépôts ----------
    - name: Désactiver le dépôt Enterprise
      ansible.builtin.replace:
        path: /etc/apt/sources.list.d/pve-enterprise.list
        regexp: '^deb'
        replace: '#deb'
      failed_when: false

    - name: Désactiver le dépôt Enterprise Ceph
      ansible.builtin.replace:
        path: /etc/apt/sources.list.d/ceph.list
        regexp: '^deb'
        replace: '#deb'
      failed_when: false

    - name: Ajouter le dépôt no-subscription
      ansible.builtin.copy:
        dest: /etc/apt/sources.list.d/pve-no-subscription.list
        content: |
          deb http://download.proxmox.com/debian/pve bookworm pve-no-subscription
        mode: '0644'

    - name: Mise à jour du système
      ansible.builtin.apt:
        update_cache: yes
        upgrade: full
        autoremove: yes

    # ---------- Réseau / noms ----------
    - name: Configurer /etc/hosts
      ansible.builtin.blockinfile:
        path: /etc/hosts
        block: |
          192.168.122.129 pve1.{{ domain }} pve1
          192.168.122.204 pve2.{{ domain }} pve2

    # ---------- Création du cluster (premier nœud) ----------
    - name: Créer le cluster (uniquement sur le premier nœud)
      ansible.builtin.command:
        cmd: "pvecm create {{ cluster_name }}"
        creates: /etc/pve/corosync.conf
      when: inventory_hostname == first_node

    - name: Attendre que le cluster soit prêt
      ansible.builtin.pause:
        seconds: 15
      when: inventory_hostname == first_node

    # ---------- Préparation SSH pour --use_ssh ----------
    - name: Générer une clé SSH root sur les nœuds à joindre
      ansible.builtin.command:
        cmd: ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ed25519
        creates: /root/.ssh/id_ed25519
      when: inventory_hostname != first_node

    - name: Lire la clé publique
      ansible.builtin.slurp:
        src: /root/.ssh/id_ed25519.pub
      register: pubkey
      when: inventory_hostname != first_node

    - name: Autoriser la clé sur le premier nœud
      ansible.posix.authorized_key:
        user: root
        key: "{{ pubkey.content | b64decode }}"
      delegate_to: "{{ first_node }}"
      when: inventory_hostname != first_node

    - name: Accepter l'empreinte SSH du premier nœud
      ansible.builtin.known_hosts:
        path: /root/.ssh/known_hosts
        name: "{{ first_node_ip }}"
        key: "{{ lookup('pipe', 'ssh-keyscan -t ed25519 ' ~ first_node_ip) }}"
      when: inventory_hostname != first_node

    # ---------- Jonction au cluster ----------
    - name: Rejoindre le cluster (via SSH)
      ansible.builtin.command:
        cmd: "pvecm add {{ first_node_ip }} --use_ssh"
        creates: /etc/pve/corosync.conf
      when: inventory_hostname != first_node
      register: join

    # ---------- Statut ----------
    - name: Afficher le statut du cluster
      ansible.builtin.command: pvecm status
      register: status
      changed_when: false
      run_once: true
      delegate_to: "{{ first_node }}"

    - name: Résultat
      ansible.builtin.debug:
        var: status.stdout_lines
      run_once: true
